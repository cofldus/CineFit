# CineFit 루트 환경변수 — 실제 값은 .env(gitignore)에만 넣을 것

# KOBIS 오픈API 키 (동기화 CLI 전용, 앱 실행에는 불필요) — https://www.kobis.or.kr/kobisopenapi
KOBIS_API_KEY=

# KMDb API 키 (승인 대기) — https://www.kmdb.or.kr/info/api/apiList
KMDB_API_KEY=

# 관리자 화면·API 비밀번호 — 미설정 시 /admin 전체 비활성
ADMIN_PASSWORD=

# ── 데이터베이스 공급자 ──────────────────────────────────────────────
# sqlite(기본, 로컬 개발) | postgres(운영·PG 개발). CINEFIT_ENV=production이면 postgres만 허용.
DATABASE_PROVIDER=

# PostgreSQL 연결 (앱 런타임용 — Supabase는 pooled 연결 문자열 권장)
# 로컬 Docker 기본값: postgres://cinefit:cinefit-dev-only@127.0.0.1:55432/cinefit_dev
DATABASE_URL=

# migration·import용 직접 연결 (미설정 시 DATABASE_URL 사용 — Supabase는 direct 연결 권장)
DATABASE_DIRECT_URL=

# 배포 환경 표시 — production이면 SQLite 선택 시 앱이 시작 단계에서 실패한다
CINEFIT_ENV=

# 로컬 Docker PostgreSQL 비밀번호 (compose.yaml — 기본 cinefit-dev-only, 운영 재사용 금지)
CINEFIT_PG_PASSWORD=

# SQLite 경로 재지정 (기본: spikes/minimal-db/cinefit-spike.db)
CINEFIT_DB_PATH=

# 시계 모드: system(기본) | demo  /  demo 기준 시각(ISO 8601)
CINEFIT_CLOCK_MODE=
CINEFIT_DEMO_NOW=

# true면 관리자 확인 회차가 있어도 합성 회차를 함께 노출 (개발·데모용)
CINEFIT_ALLOW_SYNTHETIC=
