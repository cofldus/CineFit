{
  "name": "cinefit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "영화에 딱 맞는 상영관을 찾아주는 맞춤형 영화 관람 추천 서비스 — 첫 마일스톤 PWA",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "node spikes/minimal-db/seed.mjs && node db/migrate.mjs && node db/seed-seat-zones.mjs && node db/seed-aliases.mjs",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.mjs",
    "db:status": "node --env-file-if-exists=.env db/migrate.mjs --status",
    "db:validate": "node --env-file-if-exists=.env db/migrate.mjs --validate",
    "db:import-sqlite": "node --env-file-if-exists=.env scripts/import-sqlite-to-postgres.ts",
    "pg:up": "docker compose up -d --wait postgres",
    "pg:down": "docker compose down",
    "pg:logs": "docker compose logs -f postgres",
    "pg:status": "docker compose ps postgres",
    "pg:reset": "node scripts/pg-reset.mjs",
    "sync:kobis": "node --env-file-if-exists=.env scripts/sync-kobis.ts"
  },
  "dependencies": {
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
